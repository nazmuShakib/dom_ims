{
	"name": "inventory-system",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"test": "vitest run",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"postinstall": "prisma generate",
		"seed:json": "DATA_SOURCE=json tsx scripts/seed.ts",
		"auth:bootstrap": "dotenv -e .env.local -- tsx scripts/bootstrap-admin.ts",
		"auth:migrate-mobile": "dotenv -e .env.local -- tsx scripts/migrate-mobile-auth.ts",
		"auth:recover-admin:dev": "dotenv -e .env.local -- tsx scripts/recover-admin.ts --development",
		"reconcile": "dotenv -e .env.local -- tsx scripts/reconcile.ts",
		"db:migrate": "dotenv -e .env.local -- prisma migrate dev",
		"db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
		"db:status": "dotenv -e .env.local -- prisma migrate status",
		"db:verify": "dotenv -e .env.local -- tsx scripts/verify-postgres.ts",
		"db:studio": "dotenv -e .env.local -- prisma studio",
		"db:clear-business-data:production": "tsx scripts/clear-production-business-data.ts --production-business-reset"
	},
	"dependencies": {
		"@better-auth/prisma-adapter": "^1.6.23",
		"@hookform/resolvers": "^3.9.1",
		"@prisma/client": "^6.1.0",
		"@react-pdf/renderer": "^4.5.1",
		"@tailwindcss/postcss": "^4.3.2",
		"better-auth": "^1.6.23",
		"cmdk": "^1.0.4",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"lucide-react": "^0.468.0",
		"next": "^16.2.10",
		"papaparse": "^5.4.1",
		"qrcode": "^1.5.4",
		"qrcode.react": "^4.2.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.54.0",
		"recharts": "^3.0.0",
		"tailwindcss": "^4.3.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"@types/papaparse": "^5.3.15",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"dotenv-cli": "^11.0.0",
		"prisma": "^6.1.0",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}

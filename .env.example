# Inventory backend: PostgreSQL from Phase 6. Use "json" only for legacy local data.
DATA_SOURCE="postgres"

# --- PostgreSQL ---
# DOM Cloud's internal PostgreSQL is a direct localhost connection. Use the
# exact username/database shown in Setup -> Database and percent-encode any
# URL-special characters in the password. Both variables use the same URL.
DATABASE_URL="postgresql://DOM_USERNAME:PERCENT_ENCODED_PASSWORD@localhost:5432/DOM_DATABASE?schema=public"
DATABASE_URL_UNPOOLED="postgresql://DOM_USERNAME:PERCENT_ENCODED_PASSWORD@localhost:5432/DOM_DATABASE?schema=public"

BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
# Local: http://localhost:3000
# DOM Cloud production: the exact canonical HTTPS URL.
BETTER_AUTH_URL="http://localhost:3000"

# Printed on stock labels. Defaults to "Electronics Shop" when omitted.
SHOP_NAME="Electronics Shop"
# Optional invoice header and footer details.
SHOP_ADDRESS=""
SHOP_PHONE=""
INVOICE_POLICY=""

# Staff may void only their own eligible invoice within this many minutes.
# 1440 minutes = 24 hours. ADMIN users are not time-limited.
STAFF_INVOICE_VOID_WINDOW_MINUTES="1440"

# One-time bootstrap: npm run auth:bootstrap
INITIAL_ADMIN_NAME="Shop Owner"
INITIAL_ADMIN_PHONE="01712345678"
INITIAL_ADMIN_PASSWORD="replace-with-at-least-12-characters"

# Emergency ADMIN password recovery for local development only.
# Use the POOLED URL for the development database. The recovery command deliberately
# does not fall back to DATABASE_URL. Supply the phone, password, and confirmation
# temporarily in the shell; do not save a recovery password in this file.
ADMIN_RECOVERY_DATABASE_URL="postgresql://DOM_USERNAME:PERCENT_ENCODED_PASSWORD@localhost:5432/DOM_DATABASE?schema=public"
